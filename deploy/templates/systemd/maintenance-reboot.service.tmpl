[Unit]
Description=PathFuse daily maintenance reboot (wan1 + wan2, one at a time)
# hotspot-watchdog.service: the wan1 leg is carried out by that unit's script
# (hotspot_watchdog.py --scheduled-reboot), and the watchdog owns the admin-API
# session + /run/hotspot-watchdog. Wants= (not Requires=) on purpose: if the
# watchdog is absent or dead, the wan1 leg reports a failure and the wan2 leg
# still runs — a half-done maintenance pass beats none at all.
After=network-online.target sbfd.service sbfd-ctl.service hotspot-watchdog.service
Wants=network-online.target hotspot-watchdog.service

[Service]
Type=oneshot
ExecStart=$paths_sbfdctl_opt/maintenance_reboot.py -c $paths_sbfdctl_etc/maintenance.json
# Root: it invokes the watchdog, which needs the 0600 admin secret.
#
# No RuntimeDirectory=sbfd-ctl here even though sbfd-ctl.service (which owns
# /run/sbfd-ctl) declares one: verified empirically that a SECOND unit
# declaring the same RuntimeDirectory (a) deletes the whole directory,
# including the other unit's live files, the moment ITS OWN instance stops —
# even while the owning daemon is still running — and (b) chowns the
# directory (and everything in it) to the STARTING unit's User=/Group=, which
# for this root oneshot would flip /run/sbfd-ctl from the sbfd-ctl user to
# root and could lock sbfd-ctl.service out of writing its own state. sbfd-ctl
# is required (see After=), so the plain ReadWritePaths grant below is enough.
#
# RuntimeDirectory=hotspot-watchdog + Preserve=yes is different and safe: that
# unit also runs as root (no chown mismatch), and Preserve=yes stops THIS
# unit's own exit from deleting the directory — verified against the live
# hotspot-watchdog.service on this host: its cookies.txt/state.json survived
# a oneshot run sharing the same RuntimeDirectory name while the daemon was
# active. RuntimeDirectory is still the right call over a bare
# "-/run/hotspot-watchdog" ReadWritePaths entry — that WOULD also work here
# (/run stays a read-write tmpfs under ProtectSystem=strict, unlike /var/spool
# below, which is why the spool-dir rationale there is different): declaring
# RuntimeDirectory= explicitly documents the dependency and gets systemd to
# create the dir with the right mode/owner up front, rather than relying on
# the invoked process's own mkdir as a side effect. Preserve=yes is what stops
# this oneshot's exit from deleting a directory the long-running watchdog
# daemon is still using.
RuntimeDirectory=hotspot-watchdog
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
# The leading "-" on the spool path tolerates it being absent: notify() in
# maintenance_reboot.py is contractually fail-open (never raises — a failed
# notification must not abort a reboot sequence), so degrading to a lost
# notification beats a maintenance reboot that can never start at all. Under
# ProtectSystem=strict a plain (non-dash) entry pointing at a missing path
# fails the WHOLE unit at launch (code=exited, status=226/NAMESPACE) — see
# deploy/README.md for making the directory a real prerequisite instead of
# relying on this tolerance.
ReadWritePaths=/run/sbfd-ctl -/var/spool/spool-notify
