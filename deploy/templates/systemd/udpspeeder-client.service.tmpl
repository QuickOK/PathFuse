# udpspeeder-client.service — install to /etc/systemd/system/ on the client.
# FEC client: wg0 sends here; we encode and forward to engarde-client.
#
# ORDERING: start this only AFTER engarde-client is up. engarde-client latches its single
# "wireguard" return-path source to whatever last sent to its input port
# (127.0.0.1:$ports_udpspeeder_in), so udpspeeder-client must come up after engarde-client,
# never before. (wg0's Endpoint is 127.0.0.1:$ports_udpspeeder_client from the start in this kit.)
[Unit]
Description=UDPspeeder FEC client (client, between wg0 and engarde-client)
After=network-online.target engarde-client.service
Wants=network-online.target

[Service]
Type=simple
RuntimeDirectory=udpspeeder
RuntimeDirectoryMode=0755
EnvironmentFile=$paths_udpspeeder_etc/key
ExecStartPre=/bin/sh -c 'test -p /run/udpspeeder/client.fifo || mkfifo -m 0660 /run/udpspeeder/client.fifo; chgrp sbfd /run/udpspeeder/client.fifo'
ExecStart=$paths_speederv2_bin -c -l 127.0.0.1:$ports_udpspeeder_client -r 127.0.0.1:$ports_udpspeeder_in --mode 0 --mtu 1250 --report 10 --fifo /run/udpspeeder/client.fifo -f 8:4 -k $${UDPSPEEDER_KEY}
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
