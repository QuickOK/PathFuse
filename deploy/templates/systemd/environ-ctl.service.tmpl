[Unit]
Description=PathFuse environmental redundancy controller (precip + smoke -> full)
After=network-online.target gpsd.service
Wants=network-online.target gpsd.service

[Service]
Type=simple
User=$users_sbfdctl
Group=$users_sbfdctl
ExecStart=$paths_sbfdctl_opt/environ_ctl.py -c $paths_sbfdctl_etc/environmental.json
RuntimeDirectory=sbfd-ctl
RuntimeDirectoryMode=0755
StateDirectory=sbfd-ctl
Restart=always
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ReadWritePaths=/run/sbfd-ctl /var/lib/sbfd-ctl

[Install]
WantedBy=multi-user.target
