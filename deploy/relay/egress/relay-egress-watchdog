#!/usr/bin/env python3
"""relay-egress-watchdog: relay-side egress actuator.

Enacts the client's desired egress mode on the relay. The client (sbfd-ctl) only
publishes the mode at `:8081/api/desired_egress`; this watchdog decides where the
client's decrypted traffic actually exits.

One routing table carries the client subnet's egress. This process owns two
things in it:

  * the single *preferred* default route (metric `preferred_metric`), pointed at
    the upstream the current mode selects, present only while that upstream's
    health probe passes; and
  * the exemption routes: more-specific prefixes that always leave through the
    relay's own WAN, whatever the upstream.

A lower-priority WAN default, installed by something else, stays in the table.
With no preferred route, traffic falls through to it (fail open).

Fired as a Type=oneshot by a 10 s timer. Each tick probes every upstream, polls
the client for the desired mode, then reconciles the table. README.md beside this
file documents the mode vocabulary and the config format.
"""
from __future__ import annotations

import argparse
import ipaddress
import json
import re
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path
from typing import Callable, Optional

# Canonical client egress vocabulary, exactly as sbfd-ctl publishes it at
# /api/desired_egress. This MUST match VALID_EGRESS_MODES in sbfd_ctl.py.
VALID_DESIRED_MODES = {"relay_vpn", "relay_backbone", "relay_direct", "local_direct"}

# Modes that never use an upstream: their traffic leaves through the relay's own
# WAN default (relay_direct) or never reaches the relay (local_direct).
NO_UPSTREAM_MODES = {"relay_direct", "local_direct"}

# Alternate/legacy names onto the canonical vocabulary. Unknown names pass
# through unchanged so the VALID check still rejects them.
MODE_ALIASES = {
    "upstream_vpn": "relay_vpn",
    "relay_wan": "relay_direct",
    "local": "local_direct",
}

DEFAULT_CONFIG = "/etc/relay-egress-watchdog/config.json"
_IFNAME = re.compile(r"[A-Za-z0-9_.-]{1,15}")
_UPSTREAM_NAME = re.compile(r"[a-z0-9_-]{1,32}")
_NETNS = re.compile(r"[A-Za-z0-9_.-]{1,64}")


class ConfigError(ValueError):
    """The config file is missing, unreadable or invalid."""


def normalize_mode(mode):
    """Map an alternate egress name onto the canonical client vocabulary."""
    return MODE_ALIASES.get(mode, mode)


# --- config ------------------------------------------------------------------------

def _positive(name: str, value) -> float:
    if isinstance(value, bool):
        raise ConfigError(f"{name} must be a number, got {value!r}")
    try:
        f = float(value)
    except (TypeError, ValueError):
        raise ConfigError(f"{name} must be a number, got {value!r}") from None
    if not 0 < f < float("inf"):
        raise ConfigError(f"{name} must be finite and > 0, got {value!r}")
    return f


def _count(name: str, value) -> int:
    if isinstance(value, bool) or not isinstance(value, int) or value < 1:
        raise ConfigError(f"{name} must be an integer >= 1, got {value!r}")
    return value


def _ifname(name: str, value) -> str:
    if not isinstance(value, str) or not _IFNAME.fullmatch(value):
        raise ConfigError(f"{name} must be an interface name, got {value!r}")
    return value


def _ipv4(name: str, value) -> str:
    try:
        return str(ipaddress.IPv4Address(value))
    except (ipaddress.AddressValueError, ValueError, TypeError):
        raise ConfigError(f"{name} must be an IPv4 address, got {value!r}") from None


def _validate_upstream(name, raw) -> dict:
    if not isinstance(name, str) or not _UPSTREAM_NAME.fullmatch(name):
        raise ConfigError(f"upstream name {name!r} must match [a-z0-9_-]{{1,32}}")
    if not isinstance(raw, dict):
        raise ConfigError(f"upstreams.{name} must be an object")
    route = raw.get("route")
    if not isinstance(route, dict):
        raise ConfigError(f"upstreams.{name}.route must be an object")
    dev = _ifname(f"upstreams.{name}.route.dev", route.get("dev"))
    via = route.get("via")
    if via is not None:
        via = _ipv4(f"upstreams.{name}.route.via", via)
    link = raw.get("link")
    if link is not None:
        link = _ifname(f"upstreams.{name}.link", link)
    probe = raw.get("probe")
    if not isinstance(probe, dict):
        raise ConfigError(f"upstreams.{name}.probe must be an object")
    url = probe.get("url")
    if not isinstance(url, str) or not url.startswith(("http://", "https://")):
        raise ConfigError(f"upstreams.{name}.probe.url must be an http(s) URL")
    netns, source = probe.get("netns"), probe.get("source")
    if netns is not None and source is not None:
        raise ConfigError(f"upstreams.{name}.probe: set netns or source, not both")
    if netns is not None and (not isinstance(netns, str) or not _NETNS.fullmatch(netns)):
        raise ConfigError(f"upstreams.{name}.probe.netns must be a namespace name")
    if source is not None:
        source = _ipv4(f"upstreams.{name}.probe.source", source)
    expect = probe.get("expect")
    if not isinstance(expect, str) or not expect:
        raise ConfigError(f"upstreams.{name}.probe.expect must be a non-empty regex")
    try:
        re.compile(expect)
    except re.error as e:
        raise ConfigError(f"upstreams.{name}.probe.expect: {e}") from None
    return {
        "name": name,
        "route": {"dev": dev, "via": via},
        "link": link,
        "probe": {"url": url, "netns": netns, "source": source, "expect": expect,
                  "timeout_s": _positive(f"upstreams.{name}.probe.timeout_s",
                                         probe.get("timeout_s", 5))},
        "fail_threshold": _count(f"upstreams.{name}.fail_threshold",
                                 raw.get("fail_threshold", 3)),
        "pass_threshold": _count(f"upstreams.{name}.pass_threshold",
                                 raw.get("pass_threshold", 2)),
    }


def _validate_exempt(raw) -> dict:
    empty = {"via": None, "dev": None, "prefixes": []}
    if raw is None:
        return empty
    if not isinstance(raw, dict):
        raise ConfigError("exempt must be an object")
    prefixes = raw.get("prefixes", [])
    if not isinstance(prefixes, list):
        raise ConfigError("exempt.prefixes must be a list")
    norm = []
    for p in prefixes:
        try:
            norm.append(str(ipaddress.IPv4Network(p, strict=True)))
        except (ValueError, TypeError) as e:
            raise ConfigError(f"exempt.prefixes: {p!r}: {e}") from None
    if not norm:
        return empty
    return {"via": _ipv4("exempt.via", raw.get("via")),
            "dev": _ifname("exempt.dev", raw.get("dev")),
            "prefixes": norm}


def validate_config(raw) -> dict:
    """Validate a parsed config; return it normalized, with defaults filled in."""
    if not isinstance(raw, dict):
        raise ConfigError("config must be a JSON object")
    table = raw.get("table")
    if not isinstance(table, str) or not table:
        raise ConfigError("table must be a non-empty string")
    metric = raw.get("preferred_metric", 100)
    if isinstance(metric, bool) or not isinstance(metric, int) or metric < 1:
        raise ConfigError(f"preferred_metric must be an integer >= 1, got {metric!r}")
    dry_run = raw.get("dry_run", False)
    if not isinstance(dry_run, bool):
        raise ConfigError("dry_run must be true or false")
    state_path = raw.get("state_path", "/run/relay-egress-watchdog/state.json")
    if not isinstance(state_path, str) or not state_path:
        raise ConfigError("state_path must be a non-empty string")

    craw = raw.get("client") or {}
    if not isinstance(craw, dict):
        raise ConfigError("client must be an object")
    url = craw.get("control_url", "")
    if not isinstance(url, str):
        raise ConfigError("client.control_url must be a string")
    default_mode = craw.get("default_mode", "relay_direct")
    if default_mode not in VALID_DESIRED_MODES:
        raise ConfigError(f"client.default_mode must be one of "
                          f"{sorted(VALID_DESIRED_MODES)}, got {default_mode!r}")
    client = {
        "control_url": url,
        "fetch_timeout_s": _positive("client.fetch_timeout_s", craw.get("fetch_timeout_s", 1)),
        "bootstrap_timeout_s": _positive("client.bootstrap_timeout_s",
                                         craw.get("bootstrap_timeout_s", 5)),
        "grace_s": _positive("client.grace_s", craw.get("grace_s", 60)),
        "default_mode": default_mode,
    }

    uraw = raw.get("upstreams") or {}
    if not isinstance(uraw, dict):
        raise ConfigError("upstreams must be an object")
    upstreams = {name: _validate_upstream(name, u) for name, u in uraw.items()}

    mraw = raw.get("mode_upstreams") or {}
    if not isinstance(mraw, dict):
        raise ConfigError("mode_upstreams must be an object")
    for mode, up in mraw.items():
        if mode not in VALID_DESIRED_MODES:
            raise ConfigError(f"mode_upstreams: unknown mode {mode!r}")
        if mode in NO_UPSTREAM_MODES:
            raise ConfigError(f"mode_upstreams: {mode} never uses an upstream")
        if up not in upstreams:
            raise ConfigError(f"mode_upstreams: {mode} -> {up!r} is not a configured upstream")

    return {"table": table, "preferred_metric": metric, "dry_run": dry_run,
            "state_path": state_path, "client": client, "upstreams": upstreams,
            "mode_upstreams": dict(mraw), "exempt": _validate_exempt(raw.get("exempt"))}


def load_config(path) -> dict:
    try:
        raw = json.loads(Path(path).read_text())
    except (OSError, ValueError) as e:
        raise ConfigError(f"cannot read {path}: {e}") from None
    return validate_config(raw)


# --- desired mode (client poll) ---------------------------------------------------------

def fetch_desired_mode(url: str, timeout_s: float) -> tuple:
    """GET the client's /api/desired_egress and return (mode, master_wan, err).

    Success: (mode, master_wan, None), mode normalized into VALID_DESIRED_MODES.
    Failure: (None, None, "<reason>"); the caller keeps last-known or the default.
    """
    import socket
    import urllib.error
    import urllib.request
    try:
        with urllib.request.urlopen(url, timeout=timeout_s) as r:
            body = r.read()
    except urllib.error.HTTPError as e:
        return (None, None, f"http {e.code}")
    except (urllib.error.URLError, socket.timeout, TimeoutError, OSError) as e:
        timed_out = isinstance(e, (socket.timeout, TimeoutError))
        return (None, None, "timeout" if timed_out else f"transport: {e}")
    try:
        payload = json.loads(body.decode())
    except (ValueError, UnicodeDecodeError) as e:
        return (None, None, f"parse: {e}")
    if not isinstance(payload, dict):
        return (None, None, "parse: not an object")
    mode = normalize_mode(payload.get("mode"))
    if mode not in VALID_DESIRED_MODES:
        return (None, None, f"invalid mode: {mode!r}")
    return (mode, payload.get("master_wan"), None)


def choose_fetch_timeout(last_known: Optional[str], bootstrap_s: float, regular_s: float) -> float:
    """Cold start (no last-known mode) gets the longer bootstrap timeout."""
    return bootstrap_s if last_known is None else regular_s


def effective_mode_for(desired_mode: str, age_s: float, grace_s: float, default_mode: str) -> str:
    """Desired mode while the last good fetch is within grace, else the default."""
    return desired_mode if age_s <= grace_s else default_mode


def apply_post_fetch_state_update(state: dict, fetched_mode: Optional[str],
                                  default_mode: str, now: float) -> dict:
    """Pure state update after a fetch attempt.

    Success stores the mode, refreshes fetched_at and resets the failure count.
    Failure with a last-known mode keeps it and lets the grace window run out.
    Failure on a cold start synthesizes the default at once.
    """
    s = dict(state)
    if fetched_mode is not None:
        s["desired_mode"] = fetched_mode
        s["desired_mode_fetched_at"] = now
        s["desired_mode_fetch_fail"] = 0
    else:
        s["desired_mode_fetch_fail"] = s.get("desired_mode_fetch_fail", 0) + 1
        if s.get("desired_mode") is None:
            s["desired_mode"] = default_mode
            s["desired_mode_fetched_at"] = now
    return s


# --- upstream health ----------------------------------------------------------------------

def new_health() -> dict:
    return {"healthy": False, "first_pass_seen": False, "consecutive_pass": 0,
            "consecutive_fail": 0, "last_probe": "", "last_change": 0.0}


def advance_health(h: dict, ok: bool, detail: str, now: float,
                   fail_threshold: int, pass_threshold: int) -> dict:
    """Feed one probe result through the hysteresis. Pure."""
    s = dict(h)
    s["last_probe"] = detail
    if ok:
        s["consecutive_pass"] += 1
        s["consecutive_fail"] = 0
        if not s["healthy"] and (not s["first_pass_seen"]
                                 or s["consecutive_pass"] >= pass_threshold):
            s["healthy"] = True          # first pass ever (fast boot), or a recovery
            s["last_change"] = now
        s["first_pass_seen"] = True
    else:
        s["consecutive_fail"] += 1
        s["consecutive_pass"] = 0
        if s["healthy"] and s["consecutive_fail"] >= fail_threshold:
            s["healthy"] = False
            s["last_change"] = now
    return s


# --- probes ------------------------------------------------------------------------------

def probe_argv(probe: dict) -> list:
    argv = ["curl", "--silent", "--show-error", "--max-time", f"{probe['timeout_s']:g}"]
    if probe.get("source"):
        argv += ["--interface", probe["source"]]
    argv.append(probe["url"])
    if probe.get("netns"):
        argv = ["ip", "netns", "exec", probe["netns"]] + argv
    return argv


def probe_matches(body: str, expect: str) -> Optional[str]:
    m = re.search(expect, body, re.MULTILINE)
    return m.group(0) if m else None


def link_up(iface: str, runner=subprocess.run) -> bool:
    try:
        r = runner(["ip", "-j", "link", "show", "dev", iface],
                   capture_output=True, text=True, timeout=2)
    except (subprocess.TimeoutExpired, OSError):
        return False
    if r.returncode != 0:
        return False
    try:
        flags = json.loads(r.stdout)[0].get("flags", [])
    except (ValueError, IndexError, AttributeError, TypeError):
        return False
    return "UP" in flags


def run_probe(upstream: dict, runner=subprocess.run) -> tuple:
    """(ok, detail) for one upstream: the link check, then the HTTP probe."""
    link = upstream.get("link")
    if link and not link_up(link, runner):
        return False, f"link {link} down"
    p = upstream["probe"]
    try:
        r = runner(probe_argv(p), capture_output=True, text=True, timeout=p["timeout_s"] + 3)
    except subprocess.TimeoutExpired:
        return False, "timeout"
    except OSError as e:
        return False, f"cannot run probe: {e}"
    if r.returncode != 0:
        err = (r.stderr or "").strip().replace("\n", " ")[:80]
        return False, f"curl rc={r.returncode}: {err}"
    hit = probe_matches(r.stdout or "", p["expect"])
    if hit is None:
        return False, "unexpected body"
    return True, hit


# --- route selection and reconcile ----------------------------------------------------------

def select_route(cfg: dict, effective_mode: str, health: dict) -> tuple:
    """(target upstream or None, route or None). The route is None when the mode
    uses no upstream or its upstream is unhealthy: that is the fail-open case."""
    target = cfg["mode_upstreams"].get(effective_mode)
    if target is None:
        return None, None
    if not health.get(target, {}).get("healthy"):
        return target, None
    return target, cfg["upstreams"][target]["route"]


def _norm_dst(dst: str) -> str:
    return dst if "/" in dst else f"{dst}/32"


def preferred_defaults(routes: list, metric: int) -> list:
    return [r for r in routes if r.get("dst") == "default" and r.get("metric", 0) == metric]


def plan_actions(cfg: dict, routes: list, route: Optional[dict]) -> tuple:
    """(preferred_actions, exempt_actions): `ip` argv tails, without the leading
    "ip", that move the table from `routes` (as `ip -j route show table T` lists
    it) to the desired state. Pure."""
    table, metric = cfg["table"], str(cfg["preferred_metric"])
    delete = ["route", "del", "default", "metric", metric, "table", table]
    current = preferred_defaults(routes, cfg["preferred_metric"])
    preferred = []
    if route is None:
        preferred = [list(delete) for _ in current]
    else:
        want = (route.get("via"), route["dev"])
        have = [(r.get("gateway"), r.get("dev")) for r in current]
        if have != [want]:
            if len(current) > 1:
                preferred = [list(delete) for _ in current]
            argv = ["route", "replace", "default"]
            if route.get("via"):
                argv += ["via", route["via"]]
            preferred.append(argv + ["dev", route["dev"], "metric", metric, "table", table])
    exempt = []
    ex = cfg["exempt"]
    if ex["prefixes"]:
        present = {_norm_dst(r["dst"]): (r.get("gateway"), r.get("dev"))
                   for r in routes if r.get("dst") and r.get("dst") != "default"}
        for p in ex["prefixes"]:
            if present.get(p) != (ex["via"], ex["dev"]):
                exempt.append(["route", "replace", p, "via", ex["via"],
                               "dev", ex["dev"], "table", table])
    return preferred, exempt


class IpRoute:
    """The only code that reads or changes kernel routes; tests swap in a fake."""

    def __init__(self, runner=subprocess.run):
        self._run = runner

    def show_table(self, table: str) -> list:
        r = self._run(["ip", "-j", "route", "show", "table", table],
                      capture_output=True, text=True, timeout=5)
        if r.returncode != 0:
            raise RuntimeError((r.stderr or "").strip() or f"rc={r.returncode}")
        return json.loads(r.stdout) if (r.stdout or "").strip() else []

    def apply(self, argv: list) -> tuple:
        try:
            r = self._run(["ip"] + list(argv), capture_output=True, text=True, timeout=5)
        except (subprocess.TimeoutExpired, OSError) as e:
            return False, str(e)
        return r.returncode == 0, (r.stderr or "").strip()


# --- state -----------------------------------------------------------------------------------

def load_state(path) -> dict:
    """The last tick's state, or {} when missing or unreadable (a fresh start)."""
    try:
        s = json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return {}
    return s if isinstance(s, dict) else {}


def save_state(path, state: dict) -> None:
    p = Path(path)
    p.parent.mkdir(parents=True, exist_ok=True)
    tmp = p.with_suffix(p.suffix + ".tmp")
    tmp.write_text(json.dumps(state, indent=2, sort_keys=True))
    tmp.replace(p)


def with_defaults(state: dict, cfg: dict) -> dict:
    """`state` with every key a tick needs; upstreams no longer configured are dropped."""
    s = {"desired_mode": None, "desired_mode_fetched_at": 0.0,
         "desired_mode_fetch_fail": 0, "effective_mode": None, "target": None,
         "route": None, "last_route_change": 0.0, "last_check": 0.0}
    s.update({k: v for k, v in state.items() if k != "upstreams"})
    old = state.get("upstreams") if isinstance(state.get("upstreams"), dict) else {}
    s["upstreams"] = {}
    for name in cfg["upstreams"]:
        h = new_health()
        if isinstance(old.get(name), dict):
            h.update({k: v for k, v in old[name].items() if k in h})
        s["upstreams"][name] = h
    return s


# --- one tick -----------------------------------------------------------------------------------

def _probe_all(cfg: dict, probe: Callable) -> dict:
    names = list(cfg["upstreams"])
    if not names:
        return {}
    out = {}
    with ThreadPoolExecutor(max_workers=len(names)) as pool:
        futures = {n: pool.submit(probe, cfg["upstreams"][n]) for n in names}
        for n, f in futures.items():
            try:
                out[n] = f.result()
            except Exception as e:  # a broken probe must not kill the tick
                out[n] = (False, f"probe error: {e}")
    return out


def _withdraw_all(ip, delete: list, limit: int = 8) -> None:
    for _ in range(limit):
        ok, _err = ip.apply(delete)
        if not ok:
            return


def tick(cfg: dict, state: dict, now: float, *, ip, probe: Callable = run_probe,
         fetch: Optional[Callable] = None, log: Callable = print) -> tuple:
    """Run one tick. Returns (new_state, exit_code).

    The exit code is 1 only when the preferred route could not be read or set.
    The tick has then already tried to fail open, and systemd's OnFailure runs
    the dead-man switch as a second line. Exemption-route errors are logged but
    do not fail the tick: failing it would make the dead-man switch withdraw a
    healthy preferred route every 10 s.
    """
    fetch = fetch or fetch_desired_mode
    s = with_defaults(state, cfg)
    s["last_check"] = now
    dry = cfg["dry_run"]
    tag = "DRY-RUN " if dry else ""

    for name, (ok, detail) in _probe_all(cfg, probe).items():
        up = cfg["upstreams"][name]
        before = s["upstreams"][name]["healthy"]
        s["upstreams"][name] = advance_health(s["upstreams"][name], ok, detail, now,
                                              up["fail_threshold"], up["pass_threshold"])
        after = s["upstreams"][name]["healthy"]
        if before != after:
            log(f"HEALTH: {name} {'healthy' if before else 'unhealthy'} -> "
                f"{'healthy' if after else 'unhealthy'} ({detail})")

    c = cfg["client"]
    fetch_err = "disabled"
    if c["control_url"]:
        timeout = choose_fetch_timeout(s.get("desired_mode"), c["bootstrap_timeout_s"],
                                       c["fetch_timeout_s"])
        mode, _master, fetch_err = fetch(c["control_url"], timeout)
        s = apply_post_fetch_state_update(s, mode, c["default_mode"], now)
    desired = s.get("desired_mode") or c["default_mode"]
    age = (now - s["desired_mode_fetched_at"]) if s.get("desired_mode_fetched_at") else 0.0
    effective = effective_mode_for(desired, age, c["grace_s"], c["default_mode"])
    target, route = select_route(cfg, effective, s["upstreams"])

    rc = 0
    installed = target if route is not None else None
    delete = ["route", "del", "default", "metric", str(cfg["preferred_metric"]),
              "table", cfg["table"]]
    try:
        routes = ip.show_table(cfg["table"])
    except (RuntimeError, ValueError, subprocess.TimeoutExpired, OSError) as e:
        log(f"ERROR: cannot read table {cfg['table']}: {e}")
        if not dry:
            _withdraw_all(ip, delete)
        routes, installed, rc = None, None, 1
    if routes is not None:
        preferred, exempt = plan_actions(cfg, routes, route)
        for argv in preferred + exempt:
            if dry:
                log(f"DRY-RUN would run: ip {' '.join(argv)}")
                continue
            ok, err = ip.apply(argv)
            if ok:
                continue
            log(f"ERROR: ip {' '.join(argv)}: {err}")
            if argv in preferred:
                rc = 1
        if rc and not dry:
            _withdraw_all(ip, delete)   # a half-done switch must not linger
            installed = None

    if installed != s.get("route"):
        log(f"{tag}ROUTE: {s.get('route') or 'none'} -> {installed or 'none'} (mode={effective})")
        s["route"] = installed
        s["last_route_change"] = now
    s["effective_mode"] = effective
    s["target"] = target

    health = " ".join(f"{n}={'healthy' if h['healthy'] else 'unhealthy'}({h['last_probe']})"
                      for n, h in s["upstreams"].items())
    log(f"{tag}mode={desired} eff={effective} target={target or '-'} "
        f"route={installed or 'none'} {health} fetch_err={fetch_err or '-'} "
        f"fetch_fail={s['desired_mode_fetch_fail']}")
    return s, rc


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description="Relay egress actuator: run one tick.")
    ap.add_argument("--config", default=DEFAULT_CONFIG)
    args = ap.parse_args(argv)
    try:
        cfg = load_config(args.config)
    except ConfigError as e:
        print(f"CONFIG ERROR: {e}", file=sys.stderr, flush=True)
        return 2
    state, rc = tick(cfg, load_state(cfg["state_path"]), time.time(), ip=IpRoute(),
                     log=lambda line: print(line, flush=True))
    save_state(cfg["state_path"], state)
    return rc


if __name__ == "__main__":
    sys.exit(main())
