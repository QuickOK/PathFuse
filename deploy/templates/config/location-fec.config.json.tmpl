{
  "gpsd": { "host": "$gps_host", "port": $gps_port, "max_fix_age_s": 30 },
  "wans": $wan_names_json,
  "state_path": "/run/sbfd-ctl/state.json",
  "max_state_age_s": 10,
  "store_path": "/var/lib/sbfd-ctl/location_fec_store.json",
  "output_path": "/run/sbfd-ctl/location_fec.json",
  "poll_interval_s": 1.0,
  "tile": { "precision": 7 },
  "learning": {
    "min_passes": 3,
    "alpha": 0.35,
    "pass_gap_s": 30,
    "max_tiles": 20000,
    "max_age_days": 14,
    "clean_drop_days": 7,
    "save_interval_s": 60
  },
  "withdraw": { "max_stale_s": 600 },
  "lookahead": {
    "seconds": 25,
    "min_speed_ms": 2.0,
    "sample_step_m": 75,
    "exit_hold_s": 20
  },
  "zones": []
}
