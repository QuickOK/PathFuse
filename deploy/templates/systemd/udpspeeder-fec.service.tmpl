# udpspeeder-fec.service — install to /etc/systemd/system/ on the relay.
# Adaptive FEC controller for the relay->client direction: reads relay sbfd loss,
# drives the udpspeeder-server FIFO. Runs as root (reads /run/sbfd/state.json,
# writes the root-owned FIFO dir).
# Shared key material is in $paths_udpspeeder_etc/key (UDPSPEEDER_KEY=$${UDPSPEEDER_KEY}).
[Unit]
Description=Adaptive FEC controller (relay, drives udpspeeder-server FIFO)
After=udpspeeder-server.service sbfd.service
Wants=udpspeeder-server.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 $paths_sbfd_opt/udpspeeder_fec.py -c $paths_udpspeeder_fec_etc/config.json
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
