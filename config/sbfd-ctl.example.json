{
  "wans": {
    "wan1": {
      "iface": "wan1",
      "session_id": 1,
      "label": "Cellular"
    },
    "wan2": {
      "iface": "wan2",
      "session_id": 2,
      "label": "Satellite"
    }
  },
  "relay": {
    "state_url": "http://100.64.0.2:9275/state",
    "fec_url": "http://100.64.0.2:9276/fec",
    "fetch_interval_s": 1.0,
    "fetch_timeout_s": 2.0
  },
  "engarde": {
    "server_ip": "198.51.100.10",
    "server_port": 59402,
    "admin_url": "http://127.0.0.1:8080/api/v1/get-list"
  },
  "nft": {
    "table": "sbfd_ctl",
    "family": "inet"
  },
  "egress": {
    "engarde_table": "engarde",
    "wg_iface": "wg0",
    "default_mode": "relay_vpn"
  },
  "policy": {
    "default_mode": "full",
    "default_master_policy": "static_primary",
    "default_master_wan": "wan2",
    "failback_hold_s": 30,
    "manage_default_route": true
  },
  "ui": {
    "listen": "0.0.0.0:8081"
  },
  "sbfd_local_state": "/run/sbfd/state.json",
  "runtime_state": "/run/sbfd-ctl/runtime.json",
  "persist_state": "/var/lib/sbfd-ctl/runtime.json",
  "published_state": "/run/sbfd-ctl/state.json",
  "fec": {
    "enabled": true,
    "mode": "min_adaptive",
    "fixed_ratio": "20:1",
    "floor_ratio": "20:1",
    "fifo": "/run/udpspeeder/client.fifo",
    "loss_table": [
      {
        "max_loss_pct": 0.5,
        "fec": "8:0"
      },
      {
        "max_loss_pct": 2.0,
        "fec": "8:2"
      },
      {
        "max_loss_pct": 5.0,
        "fec": "8:4"
      },
      {
        "max_loss_pct": 10.0,
        "fec": "8:6"
      },
      {
        "max_loss_pct": 100.0,
        "fec": "8:8"
      }
    ],
    "ramp_up_ticks": 2,
    "ramp_down_hold_s": 20,
    "driver_dwell_s": 120,
    "full_mode_backoff_fec": "8:0",
    "full_min_up_wans": 2,
    "wire_unit": "udpspeeder-client",
    "wan_profiles": {
      "wan1": {}
    }
  },
  "environmental": {
    "enabled": true,
    "auto_override": {
      "path": "/run/sbfd-ctl/auto_override.json",
      "ttl_s": 180
    }
  },
  "cell_telemetry": {
    "state_path": "/run/sbfd-ctl/cell_telemetry.json",
    "wan": "wan1",
    "stale_after_s": 10,
    "rsrq_degrade_db": -12,
    "rsrq_recover_db": -10,
    "rsrp_degrade_dbm": -110,
    "rsrp_recover_dbm": -108,
    "handoff_path": "/run/sbfd-ctl/cell_handoff.json",
    "handoff_ttl_s": 30
  },
  "location_fec": {
    "enabled": true,
    "state_path": "/run/sbfd-ctl/location_fec.json",
    "stale_after_s": 30
  },
  "maintenance_reboot": {
    "enabled": false,
    "hour": 0,
    "window": {
      "path": "/run/sbfd-ctl/maintenance_window.json"
    }
  },
  "map": {
    "gpsd": {
      "host": "192.0.2.10",
      "port": 2947
    },
    "tile_cache": {
      "path": "/var/lib/sbfd-ctl/tilecache",
      "max_mb": 512,
      "max_zoom": 17
    }
  },
  "notifications": {
    "topic": "pathfuse",
    "min_interval_s": 30,
    "wan_down_hold_s": 10,
    "switch_hold_s": 60,
    "fec_alerts": false
  }
}
